@article{Atkinson2001,
author = {Atkinson, Anthony C.},
title = {The comparison of designs for sequential clinical trials with covariate information},
journal = {Journal of the Royal Statistical Society: Series A (Statistics in Society)},
volume = {165},
number = {2},
pages = {349-373},
keywords = {Admissibility, Balance, Bayesian coin, Bias, Biased coin design, D            A          -optimum design, Loss Minimization, Randomization},
doi = {https://doi.org/10.1111/1467-985X.00564},
url = {https://rss.onlinelibrary.wiley.com/doi/abs/10.1111/1467-985X.00564},
eprint = {https://rss.onlinelibrary.wiley.com/doi/pdf/10.1111/1467-985X.00564},
abstract = {Summary. The paper develops methods for the comparison of randomized rules of the biased coin type for the sequential allocation of treatments in a clinical trial. One important characteristic is the loss, which measures the increase in the variance of parameter estimates due to the imbalance caused by randomization. The other important characteristic is the selection biasmeasuring the probability of correctly guessing which treatment is to be allocated next. The combination of these two measures leads to the elucidation of admissible designs. Simulations provide clear plots of the behaviour of the designs and make it possible to distinguish good designs from those which are less good.},
year = {2002}
}


@Article{Atkinson2014,
  Title                    = {Selecting a biased coin design},
  Author                   = {Anthony C. Atkinson},
  Journal                  = {Statistical Science},
  Year                     = {2014},

  Abstract                 = {Biased-coin designs are used in clinical trials to allocate
treatments with some randomness while maintaining approximately
equal allocation. More recent rules are compared with Efrons
[Biometrika 58 (1971)] biased-coin rule and extended to allow
balance over covariates. The main properties are loss of information,
due to imbalance, and selection bias. Theoretical results, mostly large
sample, are assembled and assessed by small-sample simulations. The
properties of the rules fall into three clear categories. A Bayesian rule
is shown to have appealing properties; at the cost of slight imbalance,
bias is virtually eliminated for large samples.},
  File                     = {:C\:\\Users\\duschner\\Literatur\\2014_Atkinson_SelectingABiasedCoinDesign.pdf:PDF},
  Owner                    = {duschner},
  Review                   = {Measure Imbalances in treatment allocation as loss (following Burman 1996) in the variance of the treatment effect estimator.

Review of the different measures of selection bias (Abschnitt 3)},
  Timestamp                = {2015.01.30}
}

